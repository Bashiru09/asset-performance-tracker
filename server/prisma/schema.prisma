

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets    Asset[]

}

model Asset {
  id         String   @id @default(uuid()) @db.Uuid
  categoryId String   @db.Uuid
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  monthlyRecords MonthlyAssetRecord[]

}

model MonthlyAssetRecord {
  id           String   @id @default(uuid()) @db.Uuid
  assetId      String   @db.Uuid
  month        DateTime @db.Date
  value        Decimal  @db.Decimal(15, 2)
  moneyAdded   Decimal  @default(0) @db.Decimal(15, 2)
  moneyRemoved Decimal  @default(0) @db.Decimal(15, 2)
  income       Decimal  @default(0) @db.Decimal(15, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, month])
}





